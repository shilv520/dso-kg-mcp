# 复制本文件为 .env 并填入你自己的密钥（.env 已被 git 忽略，永不提交）
# pipeline/llm.py 读取顺序：项目根 .env > 系统环境变量 > 内置默认值

# 默认：DeepSeek Anthropic 兼容端点
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=sk-your-deepseek-key
ANTHROPIC_MODEL=deepseek-chat

# 备选：阿里云百炼 MaaS（qwen3.8-max）——llm.py 对 aliyuncs 端点
# 会自动附带 thinking:disabled 提速（单片段抽取 >10min → ~1min）
# ANTHROPIC_BASE_URL=https://<your-maas-app-endpoint>/apps/anthropic
# ANTHROPIC_API_KEY=<your-aliyun-key>
# ANTHROPIC_MODEL=qwen3.8-max
