<https://example.org/dso/inst/reference-claim/mercers-theorem> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Mercer's Theorem" ;
    ns1:claimConcernsDataCharacteristic <https://example.org/dso/inst/data-characteristic/mercers-conditions> ;
    ns1:claimConcernsDomainConcept <https://example.org/dso/inst/domain-concept/kernel-function> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch05-s03-under-the-hood-p02> ;
    ns1:claimKind "domain_mechanism" ;
    ns1:claimStatement "If a function K(a, b) respects Mercer's conditions (continuous, symmetric, etc.), then there exists a function ϕ mapping a and b into another space such that K(a, b) = ϕ(a)^T · ϕ(b)." ;
    ns1:description "States that if a function satisfies Mercer's conditions, there exists a mapping such that the function equals the dot product in the mapped space." ;
    ns1:displayName "Mercer's Theorem" ;
    ns1:identifier "mercers-theorem" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

