    ns1:claimKind "descriptive" ;
    ns1:claimStatement "All neurons in a feature map share the same parameters, dramatically reducing the number of parameters and enabling the CNN to recognize a pattern anywhere once learned in one location." ;
    ns1:description "Claim that sharing parameters within a feature map reduces model size and enables translation invariance." ;
    ns1:displayName "Parameter Sharing Claim" ;
    ns1:identifier "parameter-sharing-claim" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
