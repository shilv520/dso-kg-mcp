    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/cross-entropy> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Cross Entropy" ;
    ns1:alternateName "cross entropy" ;
    ns1:description "A loss function measuring divergence between estimated and target probability distributions, used in supervised learning but not directly applicable in standard RL." ;
    ns1:displayName "Cross Entropy" ;
    ns1:identifier "cross-entropy" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "J(Θ) = -1/m Σ Σ y_k^i log(p_k^i)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch04-s05-logistic-regression>,
        <https://example.org/dso/inst/source-fragment/holml1-ch10-s01-training-an-mlp-with-tensorflow-s-high-level-api>,
