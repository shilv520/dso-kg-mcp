<https://example.org/dso/inst/reference-claim/sequential-training-drawback-in-boosting> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Sequential Training Drawback in Boosting" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/boosting> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch07-s04-boosting> ;
    ns1:claimKind "limitation" ;
    ns1:claimStatement "Sequential learning in boosting cannot be parallelized (or only partially), since each predictor can only be trained after the previous predictor has been trained and evaluated, so it does not scale as well as bagging or pasting." ;
    ns1:description "Boosting's sequential nature prevents full parallelization, limiting scalability compared to bagging or pasting." ;
    ns1:displayName "Sequential Training Drawback in Boosting" ;
    ns1:identifier "sequential-training-drawback-in-boosting" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

