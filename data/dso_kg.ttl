<https://example.org/dso/inst/reference-claim/normal-equation-computational-complexity> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Normal Equation Computational Complexity" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/normal-equation> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch04-s00-linear-regression> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "The Normal Equation computes the inverse of an n×n matrix with computational complexity typically about O(n^2.4) to O(n^3), making it very slow when the number of features grows large." ;
    ns1:description "Claim about the O(n^2.4) to O(n^3) complexity of the Normal Equation with respect to features." ;
    ns1:displayName "Normal Equation Computational Complexity" ;
    ns1:identifier "normal-equation-computational-complexity" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/normal-equation-instance-scalability> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
