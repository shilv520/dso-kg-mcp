<https://example.org/dso/inst/reference-claim/lrn-formula> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "LRN Formula" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/local-response-normalization> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch13-s03-cnn-architectures-p01> ;
    ns1:claimKind "definition" ;
    ns1:claimStatement "bi = ai / (k + alpha * sum_{j=jlow}^{jhigh} aj^2)^beta, where jhigh = min(i+r/2, fn-1) and jlow = max(0, i-r/2)." ;
    ns1:description "Mathematical formula for local response normalization: bi = ai / (k + alpha * sum(aj^2))^beta, computed across neighboring feature maps." ;
    ns1:displayName "LRN Formula" ;
    ns1:identifier "lrn-formula" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

