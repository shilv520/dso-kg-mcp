<https://example.org/dso/inst/metric/cart-cost-function> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "CART Cost Function" ;
    ns1:description "Cost function minimized by CART during classification, computing the weighted sum of left and right subset impurities based on their sizes." ;
    ns1:displayName "CART Cost Function" ;
    ns1:identifier "cart-cost-function" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "J(k, tk) = (m_left / m) * G_left + (m_right / m) * G_right" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch06-s03-the-cart-training-algorithm> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/dqn-cost-function> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "DQN Cost Function" ;
    ns1:description "Mean Squared Error between target Q-Values estimated by the actor and the critic DQN's predictions, used to train the critic network." ;
    ns1:displayName "DQN Cost Function" ;
    ns1:identifier "dqn-cost-function" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "J(θ_critic) = 1/m Σ (y_i - Q(s_i, a_i, θ_critic))^2, where y_i = r_i + γ max_a' Q(s'_i, a', θ_actor)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch16-s08-learning-to-play-ms-pac-man-using-deep-q-learning-p01> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/false-positive-rate> a ns1:Entity,
