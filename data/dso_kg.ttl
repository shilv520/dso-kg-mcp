    ns1:claimKind "procedure_advice" ;
    ns1:claimStatement "Different activation functions require specific weight initialization strategies: Xavier for logistic/tanh, He for ReLU variants." ;
    ns1:description "Use Xavier initialization for logistic/tanh activations and He initialization for ReLU and its variants to prevent vanishing/exploding gradients." ;
