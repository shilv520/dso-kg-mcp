<https://example.org/dso/inst/metric/f1-score> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "F1 Score" ;
    ns1:alternateName "F1" ;
    ns1:description "A metric measuring the harmonic mean of precision and recall, applicable to individual labels in multilabel settings." ;
