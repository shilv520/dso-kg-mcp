    ns1:claimKind "definition" ;
    ns1:claimStatement "In Machine Learning an attribute is a data type (e.g., 'Mileage'), while a feature generally means an attribute plus its value (e.g., 'Mileage = 15,000')." ;
    ns1:description "Clarifies terminology difference between attribute and feature in machine learning contexts." ;
