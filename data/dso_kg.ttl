<https://example.org/dso/inst/guideline/accuracy-limitation-on-imbalanced-data> a ns1:ClaimResource,
        ns1:Entity,
        ns1:Guideline,
        ns1:ReferenceClaim ;
    rdfs:label "Accuracy Limitation on Imbalanced Data" ;
    ns1:claimAppliesToProblemType <https://example.org/dso/inst/problem-type/binary-classification> ;
    ns1:claimAppliesUnderDataCondition <https://example.org/dso/inst/data-condition/class-imbalance> ;
    ns1:claimConcernsMetric <https://example.org/dso/inst/metric/accuracy> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch03-s02-performance-measures-p01> ;
    ns1:claimKind "warning" ;
    ns1:claimStatement "Accuracy is generally not the preferred performance measure for classifiers, especially when dealing with skewed datasets." ;
    ns1:description "Accuracy is generally not preferred for classifiers on skewed datasets because a trivial majority-class predictor can achieve high accuracy." ;
    ns1:displayName "Accuracy Limitation on Imbalanced Data" ;
    ns1:guidelineType "warning" ;
    ns1:identifier "accuracy-limitation-on-imbalanced-data" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "consensus_or_standardized" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/guideline/activation-function-selection-guideline> a ns1:ClaimResource,
        ns1:Entity,
        ns1:Guideline,
        ns1:ReferenceClaim ;
    rdfs:label "Activation Function Selection Guideline" ;
    ns1:claimConcernsEvaluationProtocol <https://example.org/dso/inst/evaluation-protocol/cross-validation> ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/exponential-linear-unit>,
        <https://example.org/dso/inst/method/leaky-relu>,
        <https://example.org/dso/inst/method/parametric-leaky-relu>,
        <https://example.org/dso/inst/method/randomized-leaky-relu>,
        <https://example.org/dso/inst/method/rectified-linear-unit> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch11-s00-vanishing-exploding-gradients-problems-p02> ;
    ns1:claimKind "selection_rule" ;
    ns1:claimStatement "In general, ELU > leaky ReLU (and its variants) > ReLU > tanh > logistic for hidden layers of deep neural networks. Prefer leaky ReLUs over ELUs if runtime performance matters most." ;
    ns1:description "General recommendation for choosing hidden layer activation functions in deep neural networks based on performance and runtime trade-offs." ;
    ns1:displayName "Activation Function Selection Guideline" ;
    ns1:guidelineType "recommendation" ;
    ns1:identifier "activation-function-selection-guideline" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

