<https://example.org/dso/inst/reference-claim/recurrent-neuron-output-equation> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Recurrent Neuron Output Equation" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/recurrent-neural-network> ;
