<https://example.org/dso/inst/activity-pattern/action-score-normalization> a ns1:ActivityPattern,
        ns1:Entity,
        ns1:ReferenceResource ;
    rdfs:label "Action Score Normalization" ;
    ns1:activityOrder 2 ;
    ns1:description "Normalizing action scores across multiple episodes by subtracting the mean and dividing by standard deviation." ;
    ns1:displayName "Action Score Normalization" ;
    ns1:identifier "action-score-normalization" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch16-s05-policy-gradients> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/activity-pattern/bias-feature-addition> a ns1:ActivityPattern,
        ns1:Entity,
        ns1:ReferenceResource ;
    rdfs:label "Bias Feature Addition" ;
    ns1:activityOrder 2 ;
    ns1:description "Adding an extra constant input feature (x0 = 1) to all training instances to account for the intercept term in linear models." ;
    ns1:displayName "Bias Feature Addition" ;
    ns1:identifier "bias-feature-addition" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch09-s04-linear-regression-with-tensorflow> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

