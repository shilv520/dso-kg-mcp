    ns1:description "Claim that finding the optimal decision tree is NP-Complete and intractable." ;
    ns1:displayName "Optimal Tree Intractability" ;
    ns1:identifier "optimal-tree-intractability" ;
    ns1:knowledgeOriginRole "data_science" ;
