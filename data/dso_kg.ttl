<https://example.org/dso/inst/reference-claim/polynomial-feature-degree-tradeoff> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Polynomial Feature Degree Tradeoff" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/polynomial-features> ;
