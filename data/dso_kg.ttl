    ns1:claimKind "definition" ;
    ns1:claimStatement "The output of a single recurrent neuron at time t equals phi(X(t)^T * Wx + Y(t-1)^T * Wy + b), combining current inputs and previous outputs via separate weight vectors." ;
    ns1:description "The output of a single recurrent neuron is computed as the activation function applied to the sum of weighted current inputs, weighted previous outputs, and bias." ;
    ns1:displayName "Recurrent Neuron Output Equation" ;
    ns1:identifier "recurrent-neuron-output-equation" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
