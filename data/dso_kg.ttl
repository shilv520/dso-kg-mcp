    ns1:claimKind "descriptive" ;
    ns1:claimStatement "The Normal Equation is linear with regards to the number of instances in the training set (O(m)), so it handles large training sets efficiently provided they fit in memory." ;
    ns1:description "Claim that Normal Equation scales linearly with the number of training instances." ;
    ns1:displayName "Normal Equation Instance Scalability" ;
