    ns1:claimKind "descriptive" ;
    ns1:claimStatement "Scikit-Learn's Perceptron class is equivalent to using an SGDClassifier with loss='perceptron', learning_rate='constant', eta0=1, and penalty=None." ;
    ns1:description "Scikit-Learn's Perceptron is equivalent to SGDClassifier with loss='perceptron', constant learning rate of 1, and no regularization." ;
