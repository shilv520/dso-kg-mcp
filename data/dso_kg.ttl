<https://example.org/dso/inst/constraint/autoencoder-output-dimension-constraint> a ns1:ClaimResource,
        ns1:Constraint,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Autoencoder Output Dimension Constraint" ;
    ns1:alternateName "Output Dimension Equals Input Dimension" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/autoencoder> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch15-s00-efficient-data-representations>,
        <https://example.org/dso/inst/source-fragment/holml1-ch15-s01-performing-pca-with-an-undercomplete-linear-autoencoder> ;
    ns1:claimKind "boundary_condition" ;
    ns1:claimStatement "In an autoencoder, the number of neurons in the output layer must be equal to the number of inputs." ;
    ns1:constraintSeverity "error" ;
    ns1:description "Hard requirement that the number of neurons in the autoencoder output layer must equal the number of inputs." ;
    ns1:displayName "Autoencoder Output Dimension Constraint" ;
    ns1:identifier "autoencoder-output-dimension-constraint" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/constraint/avoid-adagrad-for-deep-neural-networks> a ns1:ClaimResource,
        ns1:Constraint,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Avoid AdaGrad for Deep Neural Networks" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/adagrad> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch11-s02-faster-optimizers-p01> ;
    ns1:claimKind "limitation" ;
    ns1:claimStatement "You should not use AdaGrad to train deep neural networks because the learning rate gets scaled down so much that the algorithm stops before reaching the global optimum." ;
    ns1:constraintSeverity "warning" ;
    ns1:description "Hard constraint against using AdaGrad for training deep neural networks because its learning rate decays too aggressively, causing premature stopping." ;
    ns1:displayName "Avoid AdaGrad for Deep Neural Networks" ;
    ns1:identifier "avoid-adagrad-for-deep-neural-networks" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/constraint/avoid-shuffling-time-series-data> a ns1:ClaimResource,
        ns1:Constraint,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Avoid Shuffling Time Series Data" ;
    ns1:claimConcernsActivityPattern <https://example.org/dso/inst/activity-pattern/shuffle-training-data> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch03-s00-mnist> ;
    ns1:claimKind "boundary_condition" ;
    ns1:claimStatement "Shuffling may be a bad idea in some contexts—for example, if you are working on time series data." ;
    ns1:constraintSeverity "warning" ;
    ns1:description "Shuffling is inappropriate for time series data because it destroys temporal dependencies." ;
    ns1:displayName "Avoid Shuffling Time Series Data" ;
    ns1:identifier "avoid-shuffling-time-series-data" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/constraint/batch-size-constraint-for-sparsity-measurement> a ns1:ClaimResource,
        ns1:Constraint,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Batch Size Constraint for Sparsity Measurement" ;
