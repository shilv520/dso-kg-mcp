<https://example.org/dso/inst/reference-claim/perceptron-sdgclassifier-equivalence> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Perceptron-SDGClassifier Equivalence" ;
