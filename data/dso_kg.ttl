        <https://example.org/dso/inst/source-fragment/holml1-ch16-s04-evaluating-actions-the-credit-assignment-problem> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/log-loss> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Log Loss" ;
    ns1:alternateName "logistic regression cost function" ;
    ns1:description "The cost function for Logistic Regression, computed as the average negative log-likelihood over all training instances." ;
    ns1:displayName "Log Loss" ;
    ns1:identifier "log-loss" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "J(θ) = -1/m Σ [y_i log(p_i) + (1-y_i) log(1-p_i)]" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch04-s05-logistic-regression> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/mean-absolute-error> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Mean Absolute Error" ;
    ns1:alternateName "Average Absolute Deviation",
        "MAE" ;
    ns1:description "Average of absolute prediction errors. Corresponds to Manhattan (L1) norm. Less sensitive to outliers than RMSE." ;
    ns1:displayName "Mean Absolute Error" ;
    ns1:identifier "mean-absolute-error" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "1/m * sum(|h(x_i) - y_i|)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch02-s01-look-at-the-big-picture> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

