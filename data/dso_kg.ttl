    ns1:claimStatement "When preparing test data for final evaluation, you must call transform() and not fit_transform() on the pipeline to prevent fitting on test data." ;
    ns1:constraintSeverity "error" ;
    ns1:description "When evaluating on the test set, only transform() must be called on the pipeline, never fit_transform(), to avoid data leakage." ;
    ns1:displayName "Use Only Transform on Test Set" ;
    ns1:identifier "use-only-transform-on-test-set" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

