<https://example.org/dso/inst/metric/root-mean-square-error> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Root Mean Square Error" ;
    ns1:alternateName "RMSE" ;
    ns1:description "Regression evaluation metric measuring the square root of the average squared differences between predicted and actual values." ;
    ns1:displayName "Root Mean Square Error" ;
    ns1:identifier "root-mean-square-error" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "sqrt(1/m * sum((h(x_i) - y_i)^2))" ;
