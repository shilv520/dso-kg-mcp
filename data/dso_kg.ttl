<https://example.org/dso/inst/reference-claim/stale-gradient-risk-in-asynchronous-updates> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Stale Gradient Risk in Asynchronous Updates" ;
    ns1:claimConcernsDomainConcept <https://example.org/dso/inst/domain-concept/stale-gradients> ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/asynchronous-updates> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch12-s02-parallelizing-neural-networks-on-a-tensorflow-cluster-p01> ;
    ns1:claimKind "causal_hypothesis" ;
    ns1:claimStatement "In asynchronous data parallelism, by the time a replica computes gradients, parameters will have been updated by other replicas, producing stale gradients that can slow convergence." ;
    ns1:description "Claim that asynchronous data parallelism produces stale gradients because parameters are updated by other replicas before a replica finishes computing its gradients." ;
    ns1:displayName "Stale Gradient Risk in Asynchronous Updates" ;
    ns1:identifier "stale-gradient-risk-in-asynchronous-updates" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

