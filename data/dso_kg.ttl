<https://example.org/dso/inst/reference-claim/gini-impurity-vs-entropy-comparison> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Gini Impurity vs Entropy Comparison" ;
    ns1:claimConcernsMetric <https://example.org/dso/inst/metric/entropy>,
        <https://example.org/dso/inst/metric/gini-impurity> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch06-s06-regularization-hyperparameters> ;
    ns1:claimKind "comparative" ;
    ns1:claimStatement "Most of the time Gini impurity and entropy lead to similar trees. Gini impurity is slightly faster to compute. When they differ, Gini impurity tends to isolate the most frequent class in its own branch, while entropy tends to produce slightly more balanced trees." ;
    ns1:description "Gini impurity and entropy usually lead to similar trees; Gini is faster, but when they differ, Gini isolates frequent classes while entropy produces more balanced trees." ;
    ns1:displayName "Gini Impurity vs Entropy Comparison" ;
    ns1:identifier "gini-impurity-vs-entropy-comparison" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/global-average-pooling-reduces-parameters-and-overfitting> a ns1:ClaimResource,
        ns1:Entity,
