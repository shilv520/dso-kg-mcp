<https://example.org/dso/inst/reference-claim/perceptron-xor-limitation> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Perceptron XOR Limitation" ;
    ns1:claimAppliesToProblemType <https://example.org/dso/inst/problem-type/xor-classification-problem> ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/perceptron> ;
