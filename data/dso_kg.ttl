<https://example.org/dso/inst/metric/gini-impurity> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Gini Impurity" ;
    ns1:alternateName "Gini score" ;
    ns1:description "An impurity measure used in decision trees that is slightly faster to compute than entropy and tends to isolate the most frequent class." ;
    ns1:displayName "Gini Impurity" ;
    ns1:identifier "gini-impurity" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "Gi = 1 - sum(pi,k^2)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch06-s01-making-predictions>,
        <https://example.org/dso/inst/source-fragment/holml1-ch06-s05-gini-impurity-or-entropy>,
