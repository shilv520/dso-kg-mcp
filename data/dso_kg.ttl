<https://example.org/dso/inst/activity-pattern/learning-rate-tuning-via-short-runs> a ns1:ActivityPattern,
        ns1:Entity,
        ns1:ReferenceResource ;
    rdfs:label "Learning Rate Tuning via Short Runs" ;
