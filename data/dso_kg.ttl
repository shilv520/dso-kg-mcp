<https://example.org/dso/inst/metric/accuracy> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Accuracy" ;
    ns1:description "A performance measure defined as the ratio of correctly classified instances, often used in classification tasks." ;
    ns1:displayName "Accuracy" ;
    ns1:identifier "accuracy" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "maximize" ;
    ns1:metricFormula "(TP + TN) / (TP + TN + FP + FN)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch01-s01-why-use-machine-learning>,
        <https://example.org/dso/inst/source-fragment/holml1-ch03-s02-performance-measures-p01>,
