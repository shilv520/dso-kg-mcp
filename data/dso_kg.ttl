<https://example.org/dso/inst/reference-claim/vanishing-gradients-problem> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Vanishing Gradients Problem" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/reverse-mode-autodiff>,
        <https://example.org/dso/inst/method/xavier-initialization> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch11-s00-vanishing-exploding-gradients-problems-p01> ;
    ns1:claimKind "domain_mechanism" ;
    ns1:claimStatement "Gradients often get smaller as backpropagation progresses to lower layers, leaving connection weights virtually unchanged so training never converges to a good solution." ;
    ns1:description "Gradients become progressively smaller during backpropagation through lower layers, preventing weight updates and convergence." ;
    ns1:displayName "Vanishing Gradients Problem" ;
    ns1:identifier "vanishing-gradients-problem" ;
    ns1:knowledgeOriginRole "data_science" ;
