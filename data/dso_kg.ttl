    ns1:displayName "Hinge Loss" ;
    ns1:identifier "hinge-loss" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "max(0, 1 - t)" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch05-s03-under-the-hood-p02> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/metric/kullback-leibler-divergence> a ns1:Entity,
        ns1:Metric,
        ns1:ReferenceResource ;
    rdfs:label "Kullback-Leibler Divergence" ;
    ns1:alternateName "DKL",
        "KL divergence" ;
    ns1:description "A measure of divergence between two probability distributions, used as sparsity loss because it provides stronger gradients than MSE." ;
    ns1:displayName "Kullback-Leibler Divergence" ;
    ns1:identifier "kullback-leibler-divergence" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:metricDirection "minimize" ;
    ns1:metricFormula "p log(p/q) + (1-p) log((1-p)/(1-q))" ;
    ns1:resourceGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch15-s05-sparse-autoencoders>,
        <https://example.org/dso/inst/source-fragment/holml1-ch15-s06-variational-autoencoders> ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

