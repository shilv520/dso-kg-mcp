<https://example.org/dso/inst/reference-claim/variable-scope-naming-behavior> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Variable Scope Naming Behavior" ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch09-s11-sharing-variables> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "Variables created using get_variable() are named with their variable_scope as prefix, while other nodes treat the scope like a name scope." ;
    ns1:description "Variables from get_variable use variable_scope as prefix; other nodes treat variable_scope like a name scope with unique suffixes." ;
    ns1:displayName "Variable Scope Naming Behavior" ;
    ns1:identifier "variable-scope-naming-behavior" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/variable-sharing-via-reuse-flag> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Variable Sharing via Reuse Flag" ;
    ns1:claimConcernsMethodImplementation <https://example.org/dso/inst/method-implementation/tfgetvariable>,
        <https://example.org/dso/inst/method-implementation/tfvariablescope> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch09-s12-exercises> ;
    ns1:claimKind "procedure_advice" ;
    ns1:claimStatement "Setting reuse=False on the first call and reuse=True on subsequent calls within a variable scope enables sharing variables across multiple function invocations." ;
    ns1:description "In TensorFlow 1.x, setting reuse=True in a variable scope allows multiple calls to share the same variable instance." ;
    ns1:displayName "Variable Sharing via Reuse Flag" ;
    ns1:identifier "variable-sharing-via-reuse-flag" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/vectorized-rnn-layer-computation> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Vectorized RNN Layer Computation" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/recurrent-neural-network> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch14-s00-recurrent-neurons> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "The outputs of a recurrent layer for all instances in a mini-batch can be computed as Y(t) = phi([X(t), Y(t-1)] * [Wx; Wy] + b) using concatenated weight matrices." ;
    ns1:description "A whole recurrent layer's output for a mini-batch can be computed in one shot using matrix multiplication, concatenating Wx and Wy into a single weight matrix W." ;
    ns1:displayName "Vectorized RNN Layer Computation" ;
    ns1:identifier "vectorized-rnn-layer-computation" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

