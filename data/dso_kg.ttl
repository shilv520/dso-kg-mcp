<https://example.org/dso/inst/reference-claim/overfitting> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Overfitting" ;
    ns1:claimAppliesUnderDataCondition <https://example.org/dso/inst/data-condition/poor-quality-data>,
        <https://example.org/dso/inst/data-condition/small-training-set> ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/regularization> ;
    ns1:claimConcernsMetric <https://example.org/dso/inst/metric/generalization-error>,
        <https://example.org/dso/inst/metric/training-error> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch01-s03-main-challenges-of-machine-learning>,
        <https://example.org/dso/inst/source-fragment/holml1-ch01-s04-testing-and-validating> ;
    ns1:claimKind "definition" ;
    ns1:claimStatement "Overfitting means the model performs well on the training data, but it does not generalize well, happening when the model is too complex relative to the amount and noisiness of the training data." ;
    ns1:description "When a model performs well on training data but fails to generalize to new instances due to excessive complexity relative to data amount and noisiness." ;
    ns1:displayName "Overfitting" ;
    ns1:identifier "overfitting" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "consensus_or_standardized" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/overfitting-diagnosis-via-cross-validation> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Overfitting Diagnosis via Cross-Validation" ;
    ns1:claimConcernsEvaluationProtocol <https://example.org/dso/inst/evaluation-protocol/cross-validation> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch04-s03-learning-curves> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "If a model performs well on the training data but generalizes poorly according to the cross-validation metrics, then your model is overfitting." ;
    ns1:description "A model overfits if it performs well on training data but poorly according to cross-validation metrics." ;
    ns1:displayName "Overfitting Diagnosis via Cross-Validation" ;
    ns1:identifier "overfitting-diagnosis-via-cross-validation" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "consensus_or_standardized" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/overfitting-learning-curve-pattern> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Overfitting Learning Curve Pattern" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/learning-curves> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch04-s03-learning-curves> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "There is a gap between the curves. This means that the model performs signifi‐cantly better on the training data than on the validation data, which is the hall‐mark of an overfitting model." ;
    ns1:description "Overfitting models show a gap between training and validation learning curves, indicating significantly better performance on training data." ;
    ns1:displayName "Overfitting Learning Curve Pattern" ;
    ns1:identifier "overfitting-learning-curve-pattern" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "source_asserted" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/ovo-number-of-classifiers-formula> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "OvO Number of Classifiers Formula" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/one-versus-one> ;
    ns1:claimGroundedInFragment <https://example.org/dso/inst/source-fragment/holml1-ch03-s03-multiclass-classification> ;
    ns1:claimKind "descriptive" ;
    ns1:claimStatement "If there are N classes, the One-versus-One strategy requires training N × (N – 1) / 2 binary classifiers." ;
    ns1:description "Formula stating that OvO requires N*(N-1)/2 classifiers for N classes." ;
    ns1:displayName "OvO Number of Classifiers Formula" ;
    ns1:identifier "ovo-number-of-classifiers-formula" ;
    ns1:knowledgeOriginRole "data_science" ;
    ns1:referenceClaimStatus "consensus_or_standardized" ;
    ns1:resourceHasSource <https://example.org/dso/inst/knowledge-source/holml-1e> .

<https://example.org/dso/inst/reference-claim/parameter-sharing-claim> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Parameter Sharing Claim" ;
    ns1:claimConcernsMethod <https://example.org/dso/inst/method/convolutional-layer> ;
