<https://example.org/dso/inst/reference-claim/optimal-tree-intractability> a ns1:ClaimResource,
        ns1:Entity,
        ns1:ReferenceClaim ;
    rdfs:label "Optimal Tree Intractability" ;
    ns1:claimConcernsDomainConcept <https://example.org/dso/inst/domain-concept/np-complete-problem> ;
