# SHACL shapes compiled from DSO v0.2 OMM YAML (adapter/omm2schema.py).
# DSO_v0.2_Ontology_Model.yaml remains the single machine source of truth;
# this file is a derived validation artifact for the textbook Reference-Knowledge profile.
@prefix ds:   <https://example.org/dso/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ds:ActivityPattern a rdfs:Class ; rdfs:label "Activity Pattern" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Object-backed reusable professional activity pattern inside a WorkflowPattern. It expresses what should be done at an atomic professional-process level, not a data-science problem/task category. It is distinct from ProblemType and from OMM TaskType, which remains the M1 control-contract anchor." .

ds:ClaimResource a rdfs:Class ; rdfs:label "Claim Resource" ;
    rdfs:subClassOf ds:Entity ;
    rdfs:comment "Abstract proposition-bearing resource shared by ReferenceClaim, InsightCandidate and CoreInsight so that theoretical and evidence-grounded knowledge have a common claim abstraction." .

ds:Constraint a rdfs:Class ; rdfs:label "Constraint" ;
    rdfs:subClassOf ds:ReferenceClaim ;
    rdfs:comment "Normative or machine-checkable ReferenceClaim representing a hard requirement. Empirical evidence may motivate review but cannot silently override it." .

ds:DataCharacteristic a rdfs:Class ; rdfs:label "Data Characteristic" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable analytical dimension for describing data, such as missingness, distribution shape, temporal structure, cardinality, sparsity, leakage risk, or feature relationship. A DataCondition states a concrete reusable condition along such a dimension." .

ds:DataCondition a rdfs:Class ; rdfs:label "Data Condition" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable normalized state/condition of data (e.g., high missingness, strong skew, temporal drift) used as an applicability boundary. A quantitative condition MAY reference a DataStatistic and encode an operator/threshold; qualitative conditions remain valid through conditionStatement. It is distinct from OMM ConditionType, which controls Procedure/Action execution semantics." .

ds:DataStatistic a rdfs:Class ; rdfs:label "Data Statistic" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable quantitative data descriptor such as MissingRate, NullCount, Skewness, Cardinality, ClassImbalanceRatio or DriftScore. It defines what is computed; concrete observed values are DataStatisticMeasurement instances in empirical cases." .

ds:DomainConcept a rdfs:Class ; rdfs:label "Domain Concept" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable application-domain concept such as wellhead pressure, gas production rate, customer segment, or disease state." .

ds:Entity a rdfs:Class ; rdfs:label "Entity" ;
    rdfs:comment "Abstract identity-bearing base for DSO instance resources." .

ds:EvaluationProtocol a rdfs:Class ; rdfs:label "Evaluation Protocol" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable evaluation/validation design such as random holdout, group k-fold, time-series split, rolling validation, or leaderboard evaluation. It is separate from Metric: Metric says what is measured; EvaluationProtocol says how the estimate is produced." .

ds:Guideline a rdfs:Class ; rdfs:label "Guideline" ;
    rdfs:subClassOf ds:ReferenceClaim ;
    rdfs:comment "Advisory and overridable ReferenceClaim expressing recommendation, selection rule, procedure advice, or best practice under declared applicability conditions." .

ds:IndustryDomain a rdfs:Class ; rdfs:label "Industry Domain" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable application-domain area such as gas production, retail, finance, or medicine. This is application semantics, not a data-science task category." .

ds:KnowledgeSource a rdfs:Class ; rdfs:label "Knowledge Source" ;
    rdfs:subClassOf ds:Entity ;
    rdfs:comment "Bibliographic/provenance resource identifying a source document, repository, standard, notebook, code artifact, or expert source. Source authority does not by itself constitute empirical validation." .

ds:Method a rdfs:Class ; rdfs:label "Method" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable conceptual data-science method, algorithm, model family, transformation, analysis, or evaluation technique independent of one concrete implementation or trained artifact." .

ds:MethodImplementation a rdfs:Class ; rdfs:label "Method Implementation" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable implementation knowledge for a Method, such as a library class, function or model-repository artifact. Distinct from OMM ActionType, which is an executable capability contract." .

ds:Metric a rdfs:Class ; rdfs:label "Metric" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable metric definition describing what is quantified; evaluation protocol is modeled separately." .

ds:ModelSpecification a rdfs:Class ; rdfs:label "Model Specification" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable normalized model-level specification that is more concrete than a conceptual Method but is not a case-trained ModelArtifact. It may be derived from architecture specifications, model-card fragments, repository metadata or pretrained checkpoint families. A complete Method Card is a retrieval/aggregation view, not this ObjectType itself." .

ds:ProblemType a rdfs:Class ; rdfs:label "Problem Type" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable data-science task archetype (e.g., regression, classification, forecasting) separated from application-domain semantics." .

ds:ReferenceClaim a rdfs:Class ; rdfs:label "Reference Claim" ;
    rdfs:subClassOf ds:ClaimResource ;
    rdfs:comment "Reusable source-grounded proposition extracted from textbooks, standards, documentation, application-domain sources, or research literature. It is a normalized semantic assertion rather than a document summary. Its epistemic status describes standing in the reference corpus; empirical case validation is modeled separately through EvidenceRecord/CoreInsight." .

ds:ReferenceResource a rdfs:Class ; rdfs:label "Reference Resource" ;
    rdfs:subClassOf ds:Entity ;
    rdfs:comment "Abstract base for reusable semantic resources in reference knowledge. Reference resources are not bound to one empirical case; provenance is linked separately through KnowledgeSource/SourceFragment." .

ds:SoftwareComponent a rdfs:Class ; rdfs:label "Software Component" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable software package, module, service or repository component used by implementations." .

ds:SolutionTemplate a rdfs:Class ; rdfs:label "Solution Template" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable high-level solution skeleton for a ProblemType; it organizes reusable stages but is not a concrete case pipeline." .

ds:SourceFragment a rdfs:Class ; rdfs:label "Source Fragment" ;
    rdfs:subClassOf ds:Entity ;
    rdfs:comment "Traceable sub-resource inside a KnowledgeSource. SourceFragment separates structural location (chapter/section/paragraph/table/code block) from semantic role (theory, method, experiment result, standard rule, etc.) and is the preferred grounding unit for extracted knowledge." .

ds:Stage a rdfs:Class ; rdfs:label "Stage" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Reusable coarse-grained phase of a SolutionTemplate." .

ds:TransitionPattern a rdfs:Class ; rdfs:label "Transition Pattern" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Object-backed reusable transition knowledge inside a WorkflowPattern. It preserves corpus provenance and can be mapped to case transitions." .

ds:WorkflowPattern a rdfs:Class ; rdfs:label "Workflow Pattern" ;
    rdfs:subClassOf ds:ReferenceResource ;
    rdfs:comment "Object-backed reusable workflow knowledge extracted or curated from reference corpora. It supports provenance, case mapping and evidence relations. It is deliberately distinct from OMM ProcedureType, which is an M1 executable/control contract." .

ds:ShapeActivityPattern a sh:NodeShape ;
  sh:targetClass ds:ActivityPattern ;
  sh:property [ sh:path ds:activityOrder ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Recommended order of an ActivityPattern when a simple linear order exists." ] ;
  sh:property [ sh:path ds:guidance ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Lightweight local advice attached to a pattern or transition. Advice requiring independent provenance, cross-pattern reuse, applicability semantics, validation or evolution SHOULD be externalized as Guideline/ReferenceClaim." ] ;
  sh:property [ sh:path ds:pitfalls ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Lightweight local summary of mistakes or failure risks. Reusable or evidence-governed pitfalls SHOULD be externalized as Guideline/ReferenceClaim with explicit provenance and applicability." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsActivityPattern ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:methodRealizesActivityPattern ] ; sh:class ds:Method ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternContainsActivityPattern ] ; sh:class ds:WorkflowPattern ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternEntryActivity ] ; sh:class ds:WorkflowPattern ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternExitActivity ] ; sh:class ds:WorkflowPattern ] ;
  sh:property [ sh:path [ sh:inversePath ds:transitionPatternSourceActivity ] ; sh:class ds:TransitionPattern ] ;
  sh:property [ sh:path [ sh:inversePath ds:transitionPatternTargetActivity ] ; sh:class ds:TransitionPattern ] .

ds:ShapeClaimResource a sh:NodeShape ;
  sh:targetClass ds:ClaimResource ;
  sh:property [ sh:path ds:claimStatement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical proposition expressed by ReferenceClaim, InsightCandidate or CoreInsight." ] ;
  sh:property [ sh:path ds:claimKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "definition" "descriptive" "association" "causal_hypothesis" "domain_mechanism" "applicability" "assumption" "limitation" "selection_rule" "procedure_advice" "comparative" "success_pattern" "failure_pattern" "warning" "boundary_condition" "domain_dependency" "other" ) ; rdfs:comment "Semantic function of the claim." ] ;
  sh:property [ sh:path ds:applicabilitySummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Concise reusable scope and boundary summary for a claim." ] ;
  sh:property [ sh:path ds:resourceVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a source, implementation, dataset or artifact." ] ;
  sh:property [ sh:path ds:claimGroundedInFragment ; sh:class ds:SourceFragment ; rdfs:comment "Provides claim-level fine-grained provenance. A claim should prefer this relation over whole-document-only provenance when a stable fragment is available." ] ;
  sh:property [ sh:path ds:claimInIndustryDomain ; sh:class ds:IndustryDomain ; rdfs:comment "Scopes a reusable claim or insight to an IndustryDomain." ] ;
  sh:property [ sh:path ds:claimConcernsProblemType ; sh:class ds:ProblemType ; rdfs:comment "Links a claim to a problem type it defines, characterizes, compares, or otherwise discusses; this is distinct from applicability." ] ;
  sh:property [ sh:path ds:claimConcernsDomainConcept ; sh:class ds:DomainConcept ; rdfs:comment "Scopes a claim or insight to relevant application-domain concepts." ] ;
  sh:property [ sh:path ds:claimConcernsDataCharacteristic ; sh:class ds:DataCharacteristic ; rdfs:comment "Links a reusable claim to the data characteristic dimension it discusses." ] ;
  sh:property [ sh:path ds:claimConcernsDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Links a claim to a DataCondition it explicitly describes or reasons about; applicabilityUnder remains a separate relation." ] ;
  sh:property [ sh:path ds:claimConcernsMetric ; sh:class ds:Metric ; rdfs:comment "Links a reusable claim to an evaluation metric it defines, compares, limits, or recommends." ] ;
  sh:property [ sh:path ds:claimConcernsEvaluationProtocol ; sh:class ds:EvaluationProtocol ; rdfs:comment "Links a reusable claim to validation/evaluation protocol knowledge." ] ;
  sh:property [ sh:path ds:claimAppliesToProblemType ; sh:class ds:ProblemType ; rdfs:comment "Scopes a claim to one or more reusable problem types." ] ;
  sh:property [ sh:path ds:claimAppliesUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "States reusable data conditions under which a claim applies." ] ;
  sh:property [ sh:path ds:claimExcludedUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Declares a reusable data condition under which a ClaimResource must not be treated as applicable." ] ;
  sh:property [ sh:path ds:claimConcernsMethod ; sh:class ds:Method ; rdfs:comment "Associates a claim with a Method." ] ;
  sh:property [ sh:path ds:claimConcernsModelSpecification ; sh:class ds:ModelSpecification ; rdfs:comment "Links claims from model cards, repositories, papers, or documentation to reusable model specifications." ] ;
  sh:property [ sh:path ds:claimConcernsMethodImplementation ; sh:class ds:MethodImplementation ; rdfs:comment "Links implementation-specific claims to callable/API/repository implementations." ] ;
  sh:property [ sh:path ds:claimConcernsSoftwareComponent ; sh:class ds:SoftwareComponent ; rdfs:comment "Links documentation, compatibility, version, or implementation claims to software components." ] ;
  sh:property [ sh:path ds:claimConcernsSolutionTemplate ; sh:class ds:SolutionTemplate ; rdfs:comment "Associates a claim with a reusable SolutionTemplate." ] ;
  sh:property [ sh:path ds:claimAppliesToStage ; sh:class ds:Stage ; rdfs:comment "Associates a claim with a reusable Stage." ] ;
  sh:property [ sh:path ds:claimConcernsStage ; sh:class ds:Stage ; rdfs:comment "Links a claim to a Stage it defines or discusses, distinct from the claim being applicable at that stage." ] ;
  sh:property [ sh:path ds:claimConcernsWorkflowPattern ; sh:class ds:WorkflowPattern ; rdfs:comment "Associates a claim with a reusable object-backed WorkflowPattern." ] ;
  sh:property [ sh:path ds:claimConcernsActivityPattern ; sh:class ds:ActivityPattern ; rdfs:comment "Associates a claim with a reusable ActivityPattern; claims remain first-class proposition objects rather than being embedded only as activity text." ] .

ds:ShapeConstraint a sh:NodeShape ;
  sh:targetClass ds:Constraint ;
  sh:property [ sh:path ds:constraintSeverity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "error" "warning" "info" ) ; rdfs:comment "Severity of a hard constraint." ] ;
  sh:property [ sh:path ds:constraintLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional language identifier for a machine-checkable constraint expression, e.g. SHACL/SPARQL/CEL." ] ;
  sh:property [ sh:path ds:constraintExpression ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional machine-checkable expression for a Constraint. Natural-language claimStatement remains the human-readable normative statement." ] .

ds:ShapeDataCharacteristic a sh:NodeShape ;
  sh:targetClass ds:DataCharacteristic ;
  sh:property [ sh:path ds:characteristicKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "missingness" "distribution" "outlier_behavior" "class_balance" "cardinality" "sparsity" "scale" "temporal_structure" "group_structure" "feature_relationship" "multicollinearity" "distribution_shift" "noise" "sample_size" "leakage_risk" "semantic_role" "other" ) ; rdfs:comment "Analytical dimension represented by a DataCharacteristic." ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataConditionCharacterizes ] ; sh:class ds:DataCondition ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataStatisticMeasuresCharacteristic ] ; sh:class ds:DataStatistic ] ;
  sh:property [ sh:path ds:dataCharacteristicBroaderCharacteristic ; sh:class ds:DataCharacteristic ; rdfs:comment "Optional hierarchy among reusable data-characteristic dimensions." ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataCharacteristicBroaderCharacteristic ] ; sh:class ds:DataCharacteristic ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsDataCharacteristic ] ; sh:class ds:ClaimResource ] .

ds:ShapeDataCondition a sh:NodeShape ;
  sh:targetClass ds:DataCondition ;
  sh:property [ sh:path ds:dataConditionKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "missingness" "outlier" "skewness" "imbalance" "distribution_shift" "temporal_dependency" "group_structure" "sparsity" "high_cardinality" "multicollinearity" "noise" "small_sample" "other" ) ; rdfs:comment "Category of reusable data condition." ] ;
  sh:property [ sh:path ds:conditionStatement ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Reusable domain/data condition statement at the knowledge-instance level." ] ;
  sh:property [ sh:path ds:conditionOperator ; sh:maxCount 1 ; sh:in ( "eq" "ne" "gt" "ge" "lt" "le" "between" "exists" "custom" ) ; rdfs:comment "Optional machine-interpretable operator for a DataCondition based on a numeric DataStatistic." ] ;
  sh:property [ sh:path ds:conditionNumericThreshold ; sh:maxCount 1 ; sh:datatype xsd:decimal ; rdfs:comment "Optional primary numeric threshold used by a machine-interpretable DataCondition." ] ;
  sh:property [ sh:path ds:conditionNumericUpperThreshold ; sh:maxCount 1 ; sh:datatype xsd:decimal ; rdfs:comment "Optional upper numeric threshold, used primarily for between/range conditions." ] ;
  sh:property [ sh:path ds:dataConditionUsesDomainConcept ; sh:class ds:DomainConcept ; rdfs:comment "Specializes a reusable data condition with application-domain semantics when needed." ] ;
  sh:property [ sh:path ds:dataConditionCharacterizes ; sh:class ds:DataCharacteristic ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "Associates a normalized DataCondition with the reusable DataCharacteristic dimension it constrains." ] ;
  sh:property [ sh:path ds:dataConditionBasedOnStatistic ; sh:class ds:DataStatistic ; sh:maxCount 1 ; rdfs:comment "Optionally grounds a quantitative DataCondition in the reusable DataStatistic whose measurement is compared with its threshold." ] ;
  sh:property [ sh:path ds:dataConditionRefinesDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Expresses a more specific reusable data condition relative to a broader condition without turning the condition into a case observation." ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataConditionRefinesDataCondition ] ; sh:class ds:DataCondition ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsDataCondition ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimAppliesUnderDataCondition ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimExcludedUnderDataCondition ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:methodApplicableUnderDataCondition ] ; sh:class ds:Method ] ;
  sh:property [ sh:path [ sh:inversePath ds:methodExcludedUnderDataCondition ] ; sh:class ds:Method ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternApplicableUnderDataCondition ] ; sh:class ds:WorkflowPattern ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternExcludedUnderDataCondition ] ; sh:class ds:WorkflowPattern ] .

ds:ShapeDataStatistic a sh:NodeShape ;
  sh:targetClass ds:DataStatistic ;
  sh:property [ sh:path ds:statisticFormula ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional canonical formula or computation description for a reusable DataStatistic." ] ;
  sh:property [ sh:path ds:measurementUnit ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Measurement unit when applicable." ] ;
  sh:property [ sh:path ds:dataStatisticMeasuresCharacteristic ; sh:class ds:DataCharacteristic ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "Links a reusable quantitative DataStatistic to the DataCharacteristic dimension it operationalizes." ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataConditionBasedOnStatistic ] ; sh:class ds:DataCondition ] .

ds:ShapeDomainConcept a sh:NodeShape ;
  sh:targetClass ds:DomainConcept ;
  sh:property [ sh:path ds:domainConceptInIndustryDomain ; sh:class ds:IndustryDomain ; sh:minCount 1 ; rdfs:comment "Places a DomainConcept in one or more IndustryDomains." ] ;
  sh:property [ sh:path ds:domainConceptBroaderConcept ; sh:class ds:DomainConcept ; rdfs:comment "Optional broader/narrower hierarchy among reusable application-domain concepts." ] ;
  sh:property [ sh:path [ sh:inversePath ds:domainConceptBroaderConcept ] ; sh:class ds:DomainConcept ] ;
  sh:property [ sh:path [ sh:inversePath ds:problemTypeUsesDomainConcept ] ; sh:class ds:ProblemType ] ;
  sh:property [ sh:path [ sh:inversePath ds:dataConditionUsesDomainConcept ] ; sh:class ds:DataCondition ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsDomainConcept ] ; sh:class ds:ClaimResource ] .

ds:ShapeEntity a sh:NodeShape ;
  sh:targetClass ds:Entity ;
  sh:property [ sh:path ds:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Stable identifier for a DSO instance." ] ;
  sh:property [ sh:path ds:displayName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable instance name." ] ;
  sh:property [ sh:path ds:description ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Natural-language description of an instance." ] ;
  sh:property [ sh:path ds:alternateName ; sh:datatype xsd:string ; rdfs:comment "Alternative label, abbreviation, alias, or surface form used for entity normalization and cross-source matching." ] ;
  sh:property [ sh:path ds:externalIdentifier ; sh:datatype xsd:string ; rdfs:comment "Identifier assigned by an external registry, repository, standard, package ecosystem, or source system." ] ;
  sh:property [ sh:path ds:canonicalUri ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical resolvable or stable URI used to align the resource with an external identity when available." ] ;
  sh:property [ sh:path ds:resourceHasSource ; sh:class ds:KnowledgeSource ; rdfs:comment "Links any DSO instance resource to source provenance. This relation does not assert empirical validation." ] .

ds:ShapeEvaluationProtocol a sh:NodeShape ;
  sh:targetClass ds:EvaluationProtocol ;
  sh:property [ sh:path ds:evaluationProtocolType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "holdout" "kfold" "stratified_kfold" "group_kfold" "time_series_split" "rolling_window" "backtesting" "cross_validation" "leaderboard" "custom" ) ; rdfs:comment "Family of evaluation or validation protocol." ] ;
  sh:property [ sh:path ds:splitStrategy ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Normalized description of train/validation/test splitting or resampling strategy." ] ;
  sh:property [ sh:path ds:foldCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Number of folds when applicable." ] ;
  sh:property [ sh:path ds:leakageControlSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "How the protocol prevents temporal, group, target, or preprocessing leakage." ] ;
  sh:property [ sh:path [ sh:inversePath ds:problemTypeUsesEvaluationProtocol ] ; sh:class ds:ProblemType ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsEvaluationProtocol ] ; sh:class ds:ClaimResource ] .

ds:ShapeGuideline a sh:NodeShape ;
  sh:targetClass ds:Guideline ;
  sh:property [ sh:path ds:guidelineType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "recommendation" "selection_rule" "procedure_advice" "warning" "best_practice" "other" ) ; rdfs:comment "Type of Guideline claim." ] .

ds:ShapeIndustryDomain a sh:NodeShape ;
  sh:targetClass ds:IndustryDomain ;
  sh:property [ sh:path [ sh:inversePath ds:domainConceptInIndustryDomain ] ; sh:class ds:DomainConcept ] ;
  sh:property [ sh:path ds:industryDomainBroaderDomain ; sh:class ds:IndustryDomain ; rdfs:comment "Optional reusable hierarchy between application domains." ] ;
  sh:property [ sh:path [ sh:inversePath ds:industryDomainBroaderDomain ] ; sh:class ds:IndustryDomain ] ;
  sh:property [ sh:path [ sh:inversePath ds:problemTypeInIndustryDomain ] ; sh:class ds:ProblemType ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimInIndustryDomain ] ; sh:class ds:ClaimResource ] .

ds:ShapeKnowledgeSource a sh:NodeShape ;
  sh:targetClass ds:KnowledgeSource ;
  sh:property [ sh:path ds:sourceType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "textbook" "handbook" "standard" "official_documentation" "research_paper" "review_paper" "model_card" "model_repository" "competition_case" "enterprise_sop" "project_record" "notebook" "source_code" "execution_log" "expert_input" "dataset_documentation" "other" ) ; rdfs:comment "Provenance source category." ] ;
  sh:property [ sh:path ds:sourceUri ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Resolvable URI when available." ] ;
  sh:property [ sh:path ds:citation ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable bibliographic or source citation." ] ;
  sh:property [ sh:path ds:locator ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Page, section, cell, notebook block, code range, log range or other precise locator in the source." ] ;
  sh:property [ sh:path ds:publicationDate ; sh:maxCount 1 ; sh:datatype xsd:date ; rdfs:comment "Publication or release date of a source." ] ;
  sh:property [ sh:path ds:resourceVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a source, implementation, dataset or artifact." ] ;
  sh:property [ sh:path ds:license ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "License or usage terms." ] ;
  sh:property [ sh:path ds:sourceTitle ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Bibliographic or human-facing title of a knowledge source." ] ;
  sh:property [ sh:path ds:authors ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical author list serialized as text." ] ;
  sh:property [ sh:path ds:publisherOrVenue ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Publisher, journal, conference, repository, or issuing organization." ] ;
  sh:property [ sh:path ds:doi ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Digital Object Identifier when available." ] ;
  sh:property [ sh:path ds:isbn ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "ISBN when the source is a book or handbook." ] ;
  sh:property [ sh:path [ sh:inversePath ds:resourceHasSource ] ; sh:class ds:Entity ] ;
  sh:property [ sh:path ds:sourceHasFragment ; sh:class ds:SourceFragment ; rdfs:comment "Decomposes a source into traceable fragments. Every SourceFragment belongs to exactly one KnowledgeSource; a source may have zero or many fragments." ] .

ds:ShapeMethod a sh:NodeShape ;
  sh:targetClass ds:Method ;
  sh:property [ sh:path ds:methodPurpose ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "data_profiling" "data_cleaning" "data_transformation" "feature_engineering" "modeling" "optimization" "evaluation" "visualization" "deployment" "other" ) ; rdfs:comment "Purpose served by a method." ] ;
  sh:property [ sh:path ds:methodParadigm ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "rule_based" "statistical" "machine_learning" "deep_learning" "hybrid" "other" ) ; rdfs:comment "Methodological paradigm." ] ;
  sh:property [ sh:path ds:trainingMode ; sh:maxCount 1 ; sh:in ( "not_applicable" "training_free" "train_from_scratch" "pretrained" "fine_tunable" "other" ) ; rdfs:comment "Training or reuse mode." ] ;
  sh:property [ sh:path ds:assumptions ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional compact assumption summary. If an assumption is independently citable, applicability-bearing, reusable, or subject to evidence/knowledge evolution, it SHOULD be externalized as a ReferenceClaim/Guideline linked to the relevant Method or ModelSpecification." ] ;
  sh:property [ sh:path ds:limitations ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional compact limitation summary. Reusable or evidence-governed limitations SHOULD be externalized as ReferenceClaim/Guideline objects with explicit provenance and applicability." ] ;
  sh:property [ sh:path ds:resourceRequirements ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Typical computational or software requirements." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsMethod ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path ds:methodBroaderMethod ; sh:class ds:Method ; sh:maxCount 1 ; rdfs:comment "Represents method taxonomy without assuming transitive reasoning in RelationType semantics." ] ;
  sh:property [ sh:path [ sh:inversePath ds:methodBroaderMethod ] ; sh:class ds:Method ] ;
  sh:property [ sh:path [ sh:inversePath ds:modelSpecificationSpecifiesMethod ] ; sh:class ds:ModelSpecification ] ;
  sh:property [ sh:path [ sh:inversePath ds:implementationImplementsMethod ] ; sh:class ds:MethodImplementation ] ;
  sh:property [ sh:path ds:methodApplicableToProblemType ; sh:class ds:ProblemType ; rdfs:comment "Reusable applicability of a Method to a ProblemType." ] ;
  sh:property [ sh:path ds:methodApplicableUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Reusable applicability of a Method under a DataCondition." ] ;
  sh:property [ sh:path ds:methodExcludedUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Declares a reusable data condition that excludes or invalidates normal applicability of a Method." ] ;
  sh:property [ sh:path ds:methodRealizesActivityPattern ; sh:class ds:ActivityPattern ; rdfs:comment "Links a conceptual Method to the reusable ActivityPattern(s) it can realize. ActivityPattern answers what should be done; Method answers the general way to do it." ] .

ds:ShapeMethodImplementation a sh:NodeShape ;
  sh:targetClass ds:MethodImplementation ;
  sh:property [ sh:path ds:implementationType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "library_api" "class" "function" "cli" "service_api" "repository" "model_repository" "notebook" "other" ) ; rdfs:comment "Packaging form of an implementation." ] ;
  sh:property [ sh:path ds:implementationVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a concrete method implementation." ] ;
  sh:property [ sh:path ds:programmingLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Programming language of an implementation." ] ;
  sh:property [ sh:path ds:callablePath ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Import path, command or endpoint identifier." ] ;
  sh:property [ sh:path ds:invocationTemplate ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Illustrative non-runtime-bound invocation template." ] ;
  sh:property [ sh:path ds:parameterSchema ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical serialized parameter schema." ] ;
  sh:property [ sh:path ds:inputSchema ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical serialized input contract." ] ;
  sh:property [ sh:path ds:outputSchema ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical serialized output contract." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsMethodImplementation ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path ds:implementationImplementsMethod ; sh:class ds:Method ; sh:minCount 1 ; rdfs:comment "Links a reusable technical implementation to the conceptual Method it implements." ] ;
  sh:property [ sh:path ds:implementationUsesSoftwareComponent ; sh:class ds:SoftwareComponent ; rdfs:comment "Links a method implementation to required software components." ] ;
  sh:property [ sh:path ds:implementationConformsToModelSpecification ; sh:class ds:ModelSpecification ; rdfs:comment "Links an implementation entry to a reusable model specification when the implementation realizes a particular architecture/configuration/asset." ] .

ds:ShapeMetric a sh:NodeShape ;
  sh:targetClass ds:Metric ;
  sh:property [ sh:path ds:metricDirection ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "minimize" "maximize" "target_range" ) ; rdfs:comment "Optimization direction of a metric." ] ;
  sh:property [ sh:path ds:metricFormula ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human- or machine-readable formula description." ] ;
  sh:property [ sh:path ds:measurementUnit ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Measurement unit when applicable." ] ;
  sh:property [ sh:path [ sh:inversePath ds:problemTypeEvaluatedByMetric ] ; sh:class ds:ProblemType ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsMetric ] ; sh:class ds:ClaimResource ] .

ds:ShapeModelSpecification a sh:NodeShape ;
  sh:targetClass ds:ModelSpecification ;
  sh:property [ sh:path ds:modelSpecificationType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "architecture" "estimator_configuration" "pretrained_model" "checkpoint_template" "model_repository_asset" "other" ) ; rdfs:comment "Kind of reusable model specification or repository asset." ] ;
  sh:property [ sh:path ds:architectureSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Normalized architecture or estimator configuration summary." ] ;
  sh:property [ sh:path ds:parameterCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Approximate trainable/total parameter count where meaningful." ] ;
  sh:property [ sh:path ds:repositoryUri ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Canonical model/repository location when the reusable asset is externally hosted." ] ;
  sh:property [ sh:path ds:modelCardUri ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Location of a model card or equivalent documentation." ] ;
  sh:property [ sh:path ds:pretrainingSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Summary of pretraining data/objective when applicable." ] ;
  sh:property [ sh:path ds:fineTuningSupport ; sh:maxCount 1 ; sh:datatype xsd:boolean ; rdfs:comment "Whether the reusable model specification supports fine-tuning." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsModelSpecification ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path ds:modelSpecificationSpecifiesMethod ; sh:class ds:Method ; sh:minCount 1 ; rdfs:comment "Associates a reusable normalized model specification, possibly derived from model-card or repository metadata, with the conceptual method or model family it concretizes." ] ;
  sh:property [ sh:path [ sh:inversePath ds:implementationConformsToModelSpecification ] ; sh:class ds:MethodImplementation ] ;
  sh:property [ sh:path ds:modelSpecificationUsesSoftwareComponent ; sh:class ds:SoftwareComponent ; rdfs:comment "Associates a reusable model specification with libraries, repositories, modules, or services required to obtain or use it." ] .

ds:ShapeProblemType a sh:NodeShape ;
  sh:targetClass ds:ProblemType ;
  sh:property [ sh:path ds:problemCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "regression" "classification" "ranking" "clustering" "forecasting" "anomaly_detection" "dimensionality_reduction" "optimization" "other" ) ; rdfs:comment "Canonical problem category." ] ;
  sh:property [ sh:path ds:objectiveStatement ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Formal objective of a concrete or reusable problem definition." ] ;
  sh:property [ sh:path ds:successCriteria ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Success condition beyond the metric formula itself." ] ;
  sh:property [ sh:path ds:problemTypeInIndustryDomain ; sh:class ds:IndustryDomain ; rdfs:comment "Associates a reusable ProblemType with an application domain." ] ;
  sh:property [ sh:path ds:problemTypeBroaderProblemType ; sh:class ds:ProblemType ; rdfs:comment "Allows domain-scoped task archetypes such as gas-well production forecasting to specialize broader data-science problem types such as forecasting." ] ;
  sh:property [ sh:path [ sh:inversePath ds:problemTypeBroaderProblemType ] ; sh:class ds:ProblemType ] ;
  sh:property [ sh:path ds:problemTypeUsesDomainConcept ; sh:class ds:DomainConcept ; rdfs:comment "Identifies domain concepts relevant to a reusable problem archetype." ] ;
  sh:property [ sh:path ds:problemTypeEvaluatedByMetric ; sh:class ds:Metric ; rdfs:comment "Links a reusable problem archetype to suitable metrics." ] ;
  sh:property [ sh:path ds:problemTypeUsesEvaluationProtocol ; sh:class ds:EvaluationProtocol ; rdfs:comment "Associates reusable task types with commonly applicable evaluation protocols without making the protocol mandatory for every case." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsProblemType ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimAppliesToProblemType ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:methodApplicableToProblemType ] ; sh:class ds:Method ] ;
  sh:property [ sh:path [ sh:inversePath ds:solutionTemplateApplicableToProblemType ] ; sh:class ds:SolutionTemplate ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternApplicableToProblemType ] ; sh:class ds:WorkflowPattern ] .

ds:ShapeReferenceClaim a sh:NodeShape ;
  sh:targetClass ds:ReferenceClaim ;
  sh:property [ sh:path ds:knowledgeOriginRole ; sh:minCount 1 ; sh:in ( "data_science" "application_domain" "cross_domain" ) ; rdfs:comment "Whether reusable knowledge originates semantically from data-science knowledge, application-domain knowledge, or their cross-domain intersection. This is not the Problem/Data/Method/Process subject-domain axis." ] ;
  sh:property [ sh:path ds:referenceClaimStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "source_asserted" "literature_corroborated" "consensus_or_standardized" "hypothesis" "contested" "deprecated" ) ; rdfs:comment "Epistemic standing of a reusable source-grounded claim in the reference corpus." ] ;
  sh:property [ sh:path ds:revisionRationale ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional explanation of why a ReferenceClaim revision was created and what changed relative to the prior claim." ] ;
  sh:property [ sh:path ds:referenceClaimRevisionOf ; sh:class ds:ReferenceClaim ; sh:maxCount 1 ; rdfs:comment "Links a newer curated ReferenceClaim to at most one immediate prior ReferenceClaim version, preserving reference-evolution lineage." ] ;
  sh:property [ sh:path [ sh:inversePath ds:referenceClaimRevisionOf ] ; sh:class ds:ReferenceClaim ] .

ds:ShapeReferenceResource a sh:NodeShape ;
  sh:targetClass ds:ReferenceResource ;
  sh:property [ sh:path ds:knowledgeOriginRole ; sh:minCount 1 ; sh:in ( "data_science" "application_domain" "cross_domain" ) ; rdfs:comment "Whether reusable knowledge originates semantically from data-science knowledge, application-domain knowledge, or their cross-domain intersection. This is not the Problem/Data/Method/Process subject-domain axis." ] ;
  sh:property [ sh:path ds:resourceGroundedInFragment ; sh:class ds:SourceFragment ; rdfs:comment "Links a reusable semantic resource or claim to the exact source fragment from which it was extracted or normalized." ] .

ds:ShapeSoftwareComponent a sh:NodeShape ;
  sh:targetClass ds:SoftwareComponent ;
  sh:property [ sh:path ds:componentType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "library" "distribution_package" "import_package" "module" "class" "function" "cli" "service" "repository" "model_family" "other" ) ; rdfs:comment "Kind of software component." ] ;
  sh:property [ sh:path ds:resourceVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a source, implementation, dataset or artifact." ] ;
  sh:property [ sh:path ds:license ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "License or usage terms." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsSoftwareComponent ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:implementationUsesSoftwareComponent ] ; sh:class ds:MethodImplementation ] ;
  sh:property [ sh:path ds:softwareComponentPartOf ; sh:class ds:SoftwareComponent ; sh:maxCount 1 ; rdfs:comment "Represents software containment or packaging." ] ;
  sh:property [ sh:path [ sh:inversePath ds:softwareComponentPartOf ] ; sh:class ds:SoftwareComponent ] ;
  sh:property [ sh:path [ sh:inversePath ds:modelSpecificationUsesSoftwareComponent ] ; sh:class ds:ModelSpecification ] .

ds:ShapeSolutionTemplate a sh:NodeShape ;
  sh:targetClass ds:SolutionTemplate ;
  sh:property [ sh:path ds:templateVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a reusable solution or workflow pattern." ] ;
  sh:property [ sh:path ds:preconditionSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable local prerequisite summary for a reusable pattern. Independently reusable or evidence-governed prerequisites SHOULD be represented as ReferenceClaim/Guideline/Constraint objects." ] ;
  sh:property [ sh:path ds:postconditionSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable local expected-state summary for a reusable pattern. Independently reusable or evidence-governed assertions SHOULD be represented as ReferenceClaim/Guideline/Constraint objects." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsSolutionTemplate ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path ds:solutionTemplateApplicableToProblemType ; sh:class ds:ProblemType ; sh:minCount 1 ; rdfs:comment "Scopes a solution template to reusable problem archetypes." ] ;
  sh:property [ sh:path ds:solutionTemplateIncludesStage ; sh:class ds:Stage ; sh:minCount 1 ; rdfs:comment "Composes a high-level solution template from reusable stages." ] .

ds:ShapeSourceFragment a sh:NodeShape ;
  sh:targetClass ds:SourceFragment ;
  sh:property [ sh:path ds:fragmentType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "chapter" "section" "subsection" "paragraph" "figure" "table" "appendix" "code_block" "metadata_record" "other" ) ; rdfs:comment "Type of traceable fragment within a source." ] ;
  sh:property [ sh:path ds:fragmentRole ; sh:minCount 1 ; sh:in ( "definition" "background_theory" "domain_semantics" "method_description" "procedure_description" "assumption_or_limitation" "experiment_setup" "experiment_result" "discussion_or_conclusion" "implementation_reference" "model_card_section" "standard_or_sop_rule" "other" ) ; rdfs:comment "Semantic role of a source fragment for extraction/routing." ] ;
  sh:property [ sh:path ds:fragmentLocator ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Stable source-local locator such as chapter/section/page/table/figure identifiers." ] ;
  sh:property [ sh:path ds:fragmentSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Short normalized semantic summary of the fragment; not a replacement for provenance." ] ;
  sh:property [ sh:path ds:contentHash ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Optional hash for detecting source-fragment changes across ingestion runs." ] ;
  sh:property [ sh:path [ sh:inversePath ds:sourceHasFragment ] ; sh:class ds:KnowledgeSource ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ds:fragmentPartOfFragment ; sh:class ds:SourceFragment ; sh:maxCount 1 ; rdfs:comment "Represents nested source structure such as paragraph within section or section within chapter. A fragment may have at most one immediate parent; a parent may contain many child fragments." ] ;
  sh:property [ sh:path [ sh:inversePath ds:fragmentPartOfFragment ] ; sh:class ds:SourceFragment ] ;
  sh:property [ sh:path [ sh:inversePath ds:resourceGroundedInFragment ] ; sh:class ds:ReferenceResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimGroundedInFragment ] ; sh:class ds:ClaimResource ] .

ds:ShapeStage a sh:NodeShape ;
  sh:targetClass ds:Stage ;
  sh:property [ sh:path ds:stageOrder ; sh:maxCount 1 ; sh:datatype xsd:integer ; rdfs:comment "Recommended order of a reusable stage." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimAppliesToStage ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsStage ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:solutionTemplateIncludesStage ] ; sh:class ds:SolutionTemplate ] ;
  sh:property [ sh:path ds:stageContainsWorkflowPattern ; sh:class ds:WorkflowPattern ; sh:minCount 1 ; rdfs:comment "Places reusable workflow patterns in a stage." ] .

ds:ShapeTransitionPattern a sh:NodeShape ;
  sh:targetClass ds:TransitionPattern ;
  sh:property [ sh:path ds:transitionCondition ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Knowledge-instance-level transition condition text for a workflow pattern." ] ;
  sh:property [ sh:path ds:guidance ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Lightweight local advice attached to a pattern or transition. Advice requiring independent provenance, cross-pattern reuse, applicability semantics, validation or evolution SHOULD be externalized as Guideline/ReferenceClaim." ] ;
  sh:property [ sh:path ds:pitfalls ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Lightweight local summary of mistakes or failure risks. Reusable or evidence-governed pitfalls SHOULD be externalized as Guideline/ReferenceClaim with explicit provenance and applicability." ] ;
  sh:property [ sh:path [ sh:inversePath ds:workflowPatternContainsTransitionPattern ] ; sh:class ds:WorkflowPattern ] ;
  sh:property [ sh:path ds:transitionPatternSourceActivity ; sh:class ds:ActivityPattern ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "Source task of an object-backed transition pattern." ] ;
  sh:property [ sh:path ds:transitionPatternTargetActivity ; sh:class ds:ActivityPattern ; sh:minCount 1 ; sh:maxCount 1 ; rdfs:comment "Target task of an object-backed transition pattern." ] .

ds:ShapeWorkflowPattern a sh:NodeShape ;
  sh:targetClass ds:WorkflowPattern ;
  sh:property [ sh:path ds:templateVersion ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Version of a reusable solution or workflow pattern." ] ;
  sh:property [ sh:path ds:preconditionSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable local prerequisite summary for a reusable pattern. Independently reusable or evidence-governed prerequisites SHOULD be represented as ReferenceClaim/Guideline/Constraint objects." ] ;
  sh:property [ sh:path ds:postconditionSummary ; sh:maxCount 1 ; sh:datatype xsd:string ; rdfs:comment "Human-readable local expected-state summary for a reusable pattern. Independently reusable or evidence-governed assertions SHOULD be represented as ReferenceClaim/Guideline/Constraint objects." ] ;
  sh:property [ sh:path [ sh:inversePath ds:claimConcernsWorkflowPattern ] ; sh:class ds:ClaimResource ] ;
  sh:property [ sh:path [ sh:inversePath ds:stageContainsWorkflowPattern ] ; sh:class ds:Stage ] ;
  sh:property [ sh:path ds:workflowPatternContainsActivityPattern ; sh:class ds:ActivityPattern ; sh:minCount 1 ; rdfs:comment "Composes an object-backed WorkflowPattern from reusable ActivityPatterns." ] ;
  sh:property [ sh:path ds:workflowPatternContainsTransitionPattern ; sh:class ds:TransitionPattern ; rdfs:comment "Composes an object-backed workflow pattern from reusable transition patterns." ] ;
  sh:property [ sh:path ds:workflowPatternEntryActivity ; sh:class ds:ActivityPattern ; sh:minCount 1 ; rdfs:comment "Marks reusable entry ActivityPatterns." ] ;
  sh:property [ sh:path ds:workflowPatternExitActivity ; sh:class ds:ActivityPattern ; sh:minCount 1 ; rdfs:comment "Marks reusable exit ActivityPatterns." ] ;
  sh:property [ sh:path ds:workflowPatternApplicableToProblemType ; sh:class ds:ProblemType ; rdfs:comment "Scopes workflow patterns to reusable problem types." ] ;
  sh:property [ sh:path ds:workflowPatternApplicableUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Scopes workflow patterns to reusable data conditions." ] ;
  sh:property [ sh:path ds:workflowPatternExcludedUnderDataCondition ; sh:class ds:DataCondition ; rdfs:comment "Declares a data condition under which a WorkflowPattern should not be considered applicable." ] .
